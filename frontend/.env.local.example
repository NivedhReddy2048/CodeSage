# Copy to frontend/.env.local for local development.

# Base URL of the Django backend. NEXT_PUBLIC_ prefix is required for the browser to
# see it. In production this points at the Render service URL (phase 7).
NEXT_PUBLIC_API_URL=http://localhost:8000

# The free demo's per-workspace daily review cap, shown on the landing page before
# sign-in (the backend may be asleep then). Keep equal to the backend's
# DEMO_REVIEWS_PER_WORKSPACE_PER_DAY. Signed-in pages read the real figure.
NEXT_PUBLIC_DEMO_REVIEWS_PER_WORKSPACE=5
