# Copy to backend/.env for local development.
# Later phases append to this file: GITHUB_* (phase 1/2), GEMINI/GROQ keys (phase 3/4).

DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matches the services in the repo-root docker-compose.yml.
DATABASE_URL=postgres://codesage:codesage@localhost:5432/codesage
REDIS_URL=redis://localhost:6379/0
