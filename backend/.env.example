# Copy to backend/.env for local development.
# Later phases append to this file; the production-only settings are at the end.

# Must be at least 32 characters: it is the HMAC key behind session and JWT signing,
# and PyJWT warns below that length.
DJANGO_SECRET_KEY=insecure-dev-key-change-me-at-least-32-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Matches the services in the repo-root docker-compose.yml.
DATABASE_URL=postgres://codesage:codesage@localhost:5432/codesage
# Also backs the cache that holds GitHub App installation tokens.
REDIS_URL=redis://localhost:6379/0

# Signs the JWTs we issue. Kept separate from DJANGO_SECRET_KEY so either can be
# rotated alone. Falls back to DJANGO_SECRET_KEY when unset.
JWT_SIGNING_KEY=insecure-dev-jwt-key-change-me-32-chars

# ---------------------------------------------------------------------------
# GitHub OAuth App - user login ONLY (phase 1). See README.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the OAuth App's "Authorization callback URL" exactly. This is a FRONTEND
# route: the SPA receives the code and posts it to the backend, so JWTs never appear
# in a URL.
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# GitHub App - the PR loop (phase 2, spec section 13). A SEPARATE identity from the
# OAuth App above: this one owns webhooks, repo reads and PR comments, and posts
# as <app-slug>[bot]. Do not mix the two sets of credentials.
# ---------------------------------------------------------------------------

# Numeric App ID, shown at the top of the App's settings page.
GITHUB_APP_ID=

# Client ID (starts with Iv23). GitHub's docs say "Use of the client ID is
# recommended" for the JWT issuer; the App ID still works and is the fallback.
GITHUB_APP_CLIENT_ID=

# LOCAL: path to the downloaded .pem, relative to backend/. The directory is
# gitignored, as are *.pem files anywhere in the tree.
GITHUB_APP_PRIVATE_KEY_PATH=secrets/codesage.private-key.pem

# PRODUCTION: the PEM contents instead of a path, since a free dyno has nowhere to
# put a key file. Newlines may be escaped as \n. Leave blank locally.
GITHUB_APP_PRIVATE_KEY=

# Shared with GitHub so it can sign webhook deliveries; the receiver verifies
# X-Hub-Signature-256 against it. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Ingestion and embeddings (phase 3, spec section 6)
# ---------------------------------------------------------------------------

# Google AI Studio key. Used for embeddings now, and as the phase 4 LLM failover.
GEMINI_API_KEY=

# 1536, not the model's 3072 default: pgvector's hnsw/ivfflat indexes cap at 2000
# dimensions, so 3072 would be storable but unindexable and every search would
# degrade to a sequential scan. Changing this needs a migration.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Celery runs co-located with the web process on Render's free tier (spec section 7),
# so it shares REDIS_URL by default.
# CELERY_BROKER_URL=
# CELERY_TASK_ALWAYS_EAGER=False

# ---------------------------------------------------------------------------
# Review pipeline (phase 4, spec sections 5 and 14)
# ---------------------------------------------------------------------------

# Groq is the primary reviewer. Note the spec's llama-3.3-70b-versatile is NOT
# callable on a current free key - GET /v1/models does not list it - so the primary
# is openai/gpt-oss-120b: production tier, strict JSON output, 131k context.
GROQ_API_KEY=
# REVIEW_PRIMARY_MODEL=openai/gpt-oss-120b
# REVIEW_FALLBACK_MODEL=gemini-flash-lite-latest

# Live rate-limit headers report 1000 requests/day and 8000 tokens/minute, which is
# what sets the diff cap below.
# REVIEW_MAX_DIFF_BYTES=24000

# Phase 5: model tiering against Groq's shared 8000 TPM ceiling. The big model only
# where judgement matters most; the cheap one for classification and narrow passes.
# REVIEW_CHEAP_MODEL=openai/gpt-oss-20b
# Tokens one review may spend on each model (Groq's per-minute buckets are per model).
# REVIEW_TOKEN_BUDGET=6500

# ---------------------------------------------------------------------------
# Production (phase 7) - set on Render, not locally. docs/DEPLOY.md lists which
# are required. Every one below has a working default; uncomment to override.
# ---------------------------------------------------------------------------

# Turns on the production defaults: HTTPS behind the proxy, secure cookies, HSTS,
# WhiteNoise's manifest storage, remote control off. Also makes startup refuse a
# DATABASE_URL that is not Neon and a REDIS_URL on database 0.
# DJANGO_PRODUCTION=False
# Set by Render automatically; added to ALLOWED_HOSTS.
# RENDER_EXTERNAL_HOSTNAME=
# Default to CORS_ALLOWED_ORIGINS (the frontend's origin).
# CSRF_TRUSTED_ORIGINS=
# WEBSOCKET_ALLOWED_ORIGINS=
# Proxies appending to X-Forwarded-For in front of the app: 1 on Render, 0 locally.
# TRUSTED_PROXY_HOPS=
# DJANGO_SECURE_SSL_REDIRECT=
# DJANGO_SECURE_COOKIES=
# DJANGO_SECURE_HSTS_SECONDS=
# DJANGO_LOG_LEVEL=INFO
# CELERY_LOG_LEVEL=info

# Neon: connections are opened per request and closed after (scale-to-zero).
# DATABASE_CONN_MAX_AGE=0
# DATABASE_CONNECT_TIMEOUT=15

# Shared Redis (carebridge-redis): CodeSage's REDIS_URL must end in /1, never /0.
# Per-process connection caps; the budget is 15 of the instance's 50.
# REDIS_KEY_PREFIX=codesage
# REDIS_CACHE_MAX_CONNECTIONS=2
# REDIS_CHANNELS_MAX_CONNECTIONS=3
# REDIS_BROKER_MAX_CONNECTIONS=2
# CELERY_BROKER_POLLING_INTERVAL=30
# CELERY_WORKER_ENABLE_REMOTE_CONTROL=

# Missed-webhook catch-up: at most one run per interval while awake.
# CATCHUP_INTERVAL_SECONDS=1800
# CATCHUP_RATE_LIMIT_FLOOR=100

# Free-demo guardrails. Lower the review caps on evaluation days.
# DEMO_REVIEWS_PER_WORKSPACE_PER_DAY=5
# DEMO_REVIEWS_PER_DAY=35
# DEMO_MAX_REPOS_PER_WORKSPACE=3
# INGESTION_MAX_CHUNKS_PER_REPO=2000

# The App's URL slug. Optional: fetched once from GET /app when unset.
# GITHUB_APP_SLUG=
