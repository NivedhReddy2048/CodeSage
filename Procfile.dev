# One-command local development:
#
#     backend\.venv\Scripts\activate        (Windows)
#     source backend/.venv/bin/activate     (macOS / Linux)
#     honcho start -f Procfile.dev
#
# On Windows, also set PYTHONIOENCODING=utf-8 before starting. honcho prints its
# children's output through the parent's stdout, Next.js emits a non-ASCII glyph in
# its banner, and the default cp1252 console codepage makes honcho itself die with
# UnicodeEncodeError partway through startup.
#
# ACTIVATE THE VIRTUALENV FIRST. honcho spawns each command through the system
# shell, which does not inherit the venv's Scripts/ (or bin/) directory on its own.
# Console scripts like `celery` are installed there, so an unactivated shell fails
# with "'celery' is not recognized" - and honcho then tries to tear everything down
# with SIGKILL, which does not work on Windows and loops noisily.
#
# Hence `python -m celery` rather than `celery`: invoking the module needs only the
# interpreter on PATH, and resolves identically on Windows (Scripts/) and POSIX
# (bin/).
#
# Four processes, because a review needs all of them: the API receives the webhook,
# the worker runs the pipeline, smee relays GitHub's delivery to localhost, and the
# frontend serves the UI. Forgetting the worker is the usual cause of "the webhook
# arrived but no comment appeared".
#
# --pool=solo is required on Windows: Celery's default prefork pool does not work
# there and the worker silently accepts tasks it never executes.
# Both ports are pinned explicitly. honcho follows the Procfile convention of
# assigning each process type its own PORT environment variable (5000, 5100, ...),
# and Next.js honours PORT - so without `--port 3000` the frontend came up on 5300,
# which silently breaks sign-in: the OAuth App's callback URL and the backend's
# CORS allowlist both name localhost:3000.
backend: python backend/manage.py runserver 8000
worker: python -m celery -A core --workdir backend worker --loglevel=info --pool=solo
webhooks: npx --yes smee-client --url https://smee.io/pJatg6KyyGSr7ot --target http://localhost:8000/api/webhooks/github/
frontend: npm --prefix frontend run dev -- --port 3000
